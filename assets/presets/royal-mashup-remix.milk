shape_1_per_frame1=// Eight tiny, slow motes remain subtle even at low valid energy.
shape_1_per_frame2=orbit = 0.24 + 0.06*sin(instance*3.17 + 1.2);
shape_1_per_frame3=angle = instance*2.39996322973 + time*0.025;
shape_1_per_frame4=x = 0.5 + orbit*cos(angle) + 0.018*sin(time*0.11 + instance);
shape_1_per_frame5=y = 0.5 + orbit*0.72*sin(angle) + 0.014*cos(time*0.09 + instance*1.7);
shape_1_per_frame6=rad = 0.0045 + 0.0015*(0.5 + 0.5*sin(instance*5.13));
shape_1_per_frame7=ang = time*0.12 + instance;
shape_1_per_frame8=pick = instance%2;
shape_1_per_frame9=r = q9*(1-pick) + q12*pick;
shape_1_per_frame10=g = q10*(1-pick) + q13*pick;
shape_1_per_frame11=b = q11*(1-pick) + q14*pick;
shape_1_per_frame12=variation = 0.5 + 0.5*sin(instance*4.77 + 1.4);
shape_1_per_frame13=a = q19*(0.55 + 0.45*variation);
shape_1_per_frame14=a2 = a*0.45;
shape_1_per_frame15=r2 = r;
shape_1_per_frame16=g2 = g;
shape_1_per_frame17=b2 = b;

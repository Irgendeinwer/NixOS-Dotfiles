wave_1_per_point1=speed = bass_att*0.8;
wave_1_per_point2=phase = sample*1000000 + value2*bass*0.1;
wave_1_per_point3=stateX = stateX + sin(phase)*speed*atan(phase*1.51);
wave_1_per_point4=stateY = stateY + sin(phase)*speed*atan(phase*10);
wave_1_per_point5=x = 0.5 + 0.5*sin(stateX*0.1)*cos(time*0.2 + stateX);
wave_1_per_point6=y = 0.5 + 0.5*sin(stateY*0.14)*cos(time*0.1 + stateX);
wave_1_per_point7=x = x*0.8 + 0.1;
wave_1_per_point8=y = y*0.8 + 0.1;
wave_1_per_point9=x = x*0.6 + 0.2;
wave_1_per_point10=y = y*0.6 + 0.2;
wave_1_per_point11=x = 0.5 + (x-0.5)*q25;
wave_1_per_point12=y = 0.5 + (y-0.5)*q26;
wave_1_per_point13=// Accent A remains distinct from the primary and the other arcs.
wave_1_per_point14=shade = 0.90 + 0.10*sin(sample*6.28318530718 + 2.1);
wave_1_per_point15=r = q9*shade;
wave_1_per_point16=g = q10*shade;
wave_1_per_point17=b = q11*shade;
wave_1_per_point18=stateX = if(above(abs(stateX),1000),0,stateX);
wave_1_per_point19=stateY = if(above(abs(stateY),1000),0,stateY);
wave_1_per_point20=a = min(q8*1.1,0.90)*sin(sample*3.14159265359);

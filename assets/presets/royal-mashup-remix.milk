wave_3_per_point1=// The impact arc keeps priority; otherwise this existing slot carries a short comet tail.
wave_3_per_point2=stereo = value1 - value2;
wave_3_per_point3=impactRadius = 0.12 + q5*0.06;
wave_3_per_point4=impactPhase = (sample-0.5)*4.2 + time*0.25 + stereo*0.18;
wave_3_per_point5=impactX = 0.5 + impactRadius*cos(impactPhase) + stereo*0.020*cos(impactPhase);
wave_3_per_point6=impactY = 0.5 + impactRadius*0.72*sin(impactPhase) + stereo*0.020*sin(impactPhase);
wave_3_per_point7=cometProgress = min(q27/0.90,1);
wave_3_per_point8=cometPhase = (sample-0.5)*4.2 + time*0.03;
wave_3_per_point9=cometDistance = cometProgress-sample;
wave_3_per_point10=cometInTail = above(cometDistance,0)*below(cometDistance,0.23);
wave_3_per_point11=cometTailT = max(min(cometDistance/0.23,1),0);
wave_3_per_point12=cometTailAlpha = q29*q28*(1-q5)*cometInTail*(0.28-0.20*cometTailT);
wave_3_per_point13=x = if(above(q5,0.001),impactX,0.5 + 0.12*cos(cometPhase));
wave_3_per_point14=y = if(above(q5,0.001),impactY,0.5 + 0.12*0.72*sin(cometPhase));
wave_3_per_point15=x = x*0.8 + 0.1;
wave_3_per_point16=y = y*0.8 + 0.1;
wave_3_per_point17=a = max(min(q5*1.4,0.65),cometTailAlpha);
wave_3_per_point18=// Accent C complements the other blades instead of cloning their color.
wave_3_per_point19=shade = 0.90 + 0.10*sin(cometPhase*2);
wave_3_per_point20=r = q15*shade;
wave_3_per_point21=g = q16*shade;
wave_3_per_point22=b = q17*shade;

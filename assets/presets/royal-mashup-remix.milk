wave_0_per_point1=speed = bass_att*0.8;
wave_0_per_point2=phase = sample*1000000 + value2*bass*0.1;
wave_0_per_point3=stateX = stateX + sin(phase)*speed*atan(phase*1.51);
wave_0_per_point4=stateY = stateY + sin(phase)*speed*atan(phase*10);
wave_0_per_point5=x = 0.5 + 0.5*sin(stateX*0.1)*cos(time*0.2 + stateX);
wave_0_per_point6=y = 0.5 + 0.5*sin(stateY*0.12)*cos(time*0.1 + stateX);
wave_0_per_point7=x = x*0.8 + 0.1;
wave_0_per_point8=y = y*0.8 + 0.1;
wave_0_per_point9=x = 0.5 + (x-0.5)*q25;
wave_0_per_point10=y = 0.5 + (y-0.5)*q26;
wave_0_per_point11=// The primary role changes with the full palette, not a separate clock.
wave_0_per_point12=shade = 0.90 + 0.10*sin(sample*6.28318530718);
wave_0_per_point13=r = q21*shade;
wave_0_per_point14=g = q22*shade;
wave_0_per_point15=b = q23*shade;
wave_0_per_point16=stateX = if(above(abs(stateX),1000),0,stateX);
wave_0_per_point17=stateY = if(above(abs(stateY),1000),0,stateY);
wave_0_per_point18=a = q6*sin(sample*3.14159265359);

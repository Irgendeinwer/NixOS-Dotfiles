shape_3_per_frame1=// One bounded comet head follows the existing impact arc.
shape_3_per_frame2=progress = min(q27/0.90,1);
shape_3_per_frame3=angle = (progress-0.5)*4.2 + time*0.03;
shape_3_per_frame4=x = 0.5 + 0.12*0.8*cos(angle);
shape_3_per_frame5=y = 0.5 + 0.12*0.72*0.8*sin(angle);
shape_3_per_frame6=rad = 0.007 + 0.002*q28;
shape_3_per_frame7=ang = angle + 1.57079632679;
shape_3_per_frame8=r = q15;
shape_3_per_frame9=g = q16;
shape_3_per_frame10=b = q17;
shape_3_per_frame11=a = q29*q28*(1-min(q5,1))*0.88;
shape_3_per_frame12=a2 = a*0.45;
shape_3_per_frame13=r2 = r;
shape_3_per_frame14=g2 = g;
shape_3_per_frame15=b2 = b;
per_frame_1=// Keep the original per-frame shape, blade, and warp motion.
per_frame_2=// Time-normalizing their geometry fragments continuous arcs at high refresh rates.
per_frame_3=// Impact and groove envelopes below remain time-based.
per_frame_4=// Original textured-shape clock.
per_frame_5=// Optional Feishin input: previous-frame stereo RMS plus a validity epsilon.
per_frame_6=absoluteInput = b3n;
per_frame_7=absoluteAvailable = above(absoluteInput,0);
per_frame_8=b3n = 0;
per_frame_9=shapeClock = shapeClock + bass*0.03;
per_frame_10=shapeClock = if(below(shapeClock,1000),1000,shapeClock);
per_frame_11=shapeClock = shapeClock + bass_att*0.03;
per_frame_12=q1 = shapeClock*4;
per_frame_13=// Alternating one-second energy windows preserve the original beat response.
per_frame_14=energy = pow(bass+mid+treb,2);
per_frame_15=bucket = floor(time)%2;
per_frame_16=bucketChanged = bnot(equal(lastBucket,bucket));
per_frame_17=energy1 = energy1 - energy1*bucketChanged*bucket;
per_frame_18=energy2 = energy2 - energy2*bucketChanged*equal(bucket,0);
per_frame_19=samples1 = samples1 - samples1*bucketChanged*bucket;
per_frame_20=samples2 = samples2 - samples2*bucketChanged*equal(bucket,0);
per_frame_21=energy1 = energy1 + energy*equal(bucket,1);
per_frame_22=samples1 = samples1 + equal(bucket,1);
per_frame_23=energy2 = energy2 + energy*equal(bucket,0);
per_frame_24=samples2 = samples2 + equal(bucket,0);
per_frame_25=lastBucket = bucket;
per_frame_26=// Require a reference window; normalized bands surge on the first sound after silence.
per_frame_27=avgOther = if(equal(bucket,1),energy2/max(samples2,1),energy1/max(samples1,1));
per_frame_28=noiseFloor = 10.0;
per_frame_29=detectorReady = above(avgOther,noiseFloor);
per_frame_30=energyRatio = energy/max(avgOther,noiseFloor);
per_frame_31=q3 = min(energyRatio,3)*detectorReady;
per_frame_32=// Long-term references learn only from source frames with a valid local history.
per_frame_33=adaptiveFloor = 4.0;
per_frame_34=frameDt = 1/max(fps,1);
per_frame_35=absoluteRMS = max(absoluteInput-0.000001,0);
per_frame_36=absoluteLevel = min(absoluteRMS*3.0,1);
per_frame_37=absoluteFastPrevious = absoluteFast;
per_frame_38=absoluteFast = if(absoluteAvailable,absoluteFast+(absoluteLevel-absoluteFast)*(1-pow(0.002,frameDt)),absoluteFast);
per_frame_39=absoluteSlowRetention = if(below(absoluteLevel,absoluteSlow),0.12,0.35);
per_frame_40=absoluteSlow = if(absoluteAvailable,absoluteSlow+(absoluteLevel-absoluteSlow)*(1-pow(absoluteSlowRetention,frameDt)),absoluteSlow);
per_frame_41=absoluteSteady = 0.56*max(min((absoluteSlow-0.12)/0.60,1),0)*absoluteAvailable;
per_frame_42=adaptiveEnergy = energy*detectorReady;
per_frame_43=fastEnergy = fastEnergy + (adaptiveEnergy-fastEnergy)*(1-pow(0.00001,frameDt));
per_frame_44=sustainedEnergy = sustainedEnergy + (adaptiveEnergy-sustainedEnergy)*(1-pow(0.25,frameDt));
per_frame_45=silenceClock = if(below(max(adaptiveEnergy,avgOther),adaptiveFloor),silenceClock+frameDt,0);
per_frame_46=learningTime = if(above(silenceClock,6),0,learningTime);
per_frame_47=learningTime = min(learningTime+frameDt*detectorReady,2.1);
per_frame_48=adaptiveReady = above(learningTime,2);
per_frame_49=slowEnergy = if(adaptiveReady,slowEnergy,fastEnergy);
per_frame_50=peakEnergy = if(adaptiveReady,peakEnergy,fastEnergy);
per_frame_51=slowRetention = if(below(fastEnergy,slowEnergy),0.82,0.88);
per_frame_52=slowEnergy = slowEnergy + (fastEnergy-slowEnergy)*(1-pow(slowRetention,frameDt));
per_frame_53=relativeEnergy = fastEnergy/max(slowEnergy,adaptiveFloor);
per_frame_54=sustainedRatio = sustainedEnergy/max(slowEnergy,adaptiveFloor);
per_frame_55=peakReference = min(peakEnergy,4*slowEnergy);
per_frame_56=peakRatio = fastEnergy/max(peakReference,adaptiveFloor);
per_frame_57=peakEnergy = max(fastEnergy,peakEnergy*pow(0.80,frameDt));
per_frame_58=// Sustained activity drives groove; fast contrast and recent peaks own transients.
per_frame_59=activityT = max(min((sustainedRatio-0.15)/1.15,1),0)*detectorReady;
per_frame_60=bodyContrast = max(min((relativeEnergy-1.6)/3.4,1),0);
per_frame_61=bodyPeak = max(min((peakRatio-1.08)/0.32,1),0);
per_frame_62=adaptiveBodyT = bodyContrast*bodyPeak*detectorReady;
per_frame_63=adaptiveBodyTarget = adaptiveBodyT*adaptiveBodyT*(3-2*adaptiveBodyT);
per_frame_64=hardContrast = max(min((relativeEnergy-2.5)/2.5,1),0);
per_frame_65=hardPeak = max(min((peakRatio-1.15)/0.50,1),0);
per_frame_66=adaptiveHardT = hardContrast*hardPeak*detectorReady;
per_frame_67=adaptiveHard = adaptiveHardT*adaptiveHardT*(3-2*adaptiveHardT);
per_frame_68=// Retain the original guarded response while the adaptive reference learns.
per_frame_69=legacyBodyT = max(min((energyRatio-3)/11,1),0)*detectorReady;
per_frame_70=legacyBodyTarget = legacyBodyT*legacyBodyT*(3-2*legacyBodyT);
per_frame_71=legacyHard = if(above(energyRatio,10),min((energyRatio-10)*0.06,1),0)*detectorReady;
per_frame_72=legacySteady = 0.40*min(energyRatio,1)*detectorReady;
per_frame_73=bodyTarget = legacyBodyTarget*(1-adaptiveReady)+adaptiveBodyTarget*adaptiveReady;
per_frame_74=hardTransient = legacyHard*(1-adaptiveReady)+adaptiveHard*adaptiveReady;
per_frame_75=// Latch loud sections through averaging; release only on a real downward transition.
per_frame_76=sectionQuiet = if(absoluteAvailable,below(absoluteFast,0.16),below(energyRatio,0.30));
per_frame_77=sectionQuietTime = if(sectionQuiet,sectionQuietTime+frameDt,0);
per_frame_78=sectionActive = if(above(sectionQuietTime,0.65),0,sectionActive);
per_frame_79=sectionLevel = if(above(sectionQuietTime,0.65),0,sectionLevel);
per_frame_80=sectionRise = above(sustainedRatio,1.20)*above(relativeEnergy,1.05);
per_frame_81=sectionSignal = max(sectionRise,absoluteAvailable*above(absoluteFast,0.20));
per_frame_82=sectionRiseTime = if(sectionSignal,sectionRiseTime+frameDt,0);
per_frame_83=sectionEnter = above(sectionRiseTime,0.40)*max(detectorReady,absoluteAvailable);
per_frame_84=sectionCandidate = min(0.28 + 0.22*max(bodyTarget,hardTransient) + 0.42*max(min(sustainedRatio-1,1),0) + 0.12*max(min(relativeEnergy-1,1),0),0.58);
per_frame_85=sectionActive = max(sectionActive,sectionEnter);
per_frame_86=sectionLevel = if(sectionEnter,max(sectionLevel,sectionCandidate),sectionLevel);
per_frame_87=sectionFallback = sectionActive*sectionLevel*(1-absoluteAvailable*min(absoluteSlow*1.5,1));
per_frame_88=adaptiveSteady = max(max(0.40*activityT,sectionFallback),absoluteSteady);
per_frame_89=steadyActivity = legacySteady*(1-adaptiveReady)+adaptiveSteady*adaptiveReady;
per_frame_90=steadyActivity = max(steadyActivity,absoluteSteady);
per_frame_91=// Medium-impact body fills the groove-to-drop middle without owning the orbit.
per_frame_92=body = max(bodyTarget,body*pow(0.002,frameDt));
per_frame_93=body = if(below(body,0.001),0,body);
per_frame_94=// Hard spikes and their releasing envelope remain reserved for genuine impacts.
per_frame_95=q4 = hardTransient*hardTransient;
per_frame_96=impact = max(hardTransient,impact*pow(0.002,frameDt));
per_frame_97=impact = if(below(impact,0.002),0,impact);
per_frame_98=q5 = impact;
per_frame_99=mv_a = q5;
per_frame_100=// Groove owns sustained activity only, so body hits cannot hold it high.
per_frame_101=grooveTarget = steadyActivity;
per_frame_102=groove = max(grooveTarget,groove*pow(0.1,frameDt));
per_frame_103=groove = if(below(groove,0.01),0,groove);
per_frame_104=// Zoom is continuous by default; section detection must not gate it.
per_frame_105=zoomDrive = min(energyRatio,3);
per_frame_106=q7 = max(max(zoomDrive,2.5*groove),0.35)+q5;
per_frame_107=restLevel = 0.12;
per_frame_108=level = min(restLevel + max(0.36*groove,max(0.45*body,0.65*q5)),1);
per_frame_109=q6 = level;
per_frame_110=q8 = max((level-restLevel)/(1-restLevel),0);
per_frame_111=q2 = detectorReady;
per_frame_112=q24 = sectionActive*sectionLevel;
per_frame_113=paletteValid = max(q2,absoluteAvailable*above(absoluteFast,0.04));
per_frame_114=ambientValid = max(q2,absoluteAvailable*above(absoluteFast,0.005));
per_frame_115=// Seeded at runtime from the event counter, time, and musical energy.
per_frame_116=paletteIdle = paletteIdle + frameDt*paletteValid;
per_frame_117=paletteCooldown = max(paletteCooldown-frameDt,0);
per_frame_118=paletteHit = above(max(bodyTarget,hardTransient),0.55)*below(lastPaletteHit,0.55);
per_frame_119=lastPaletteHit = max(bodyTarget,hardTransient);
per_frame_120=paletteSection = bnot(equal(sectionActive,lastPaletteSection));
per_frame_121=lastPaletteSection = sectionActive;
per_frame_122=paletteEvent = min(paletteHit+paletteSection+above(paletteIdle,6),1)*below(paletteCooldown,0.001)*above(paletteMorph,0.995)*paletteValid;
per_frame_123=paletteBootstrap = below(paletteInitialized,0.5);
per_frame_124=paletteGenerate = max(paletteBootstrap,paletteEvent);
per_frame_125=paletteInitialized = 1;
per_frame_126=paletteGeneration = paletteGeneration + paletteGenerate;
per_frame_127=paletteEpoch = if(paletteGenerate,time + min(energy,1000)*0.173,paletteEpoch);
per_frame_128=paletteHashSeed = paletteGeneration*12.9898 + paletteEpoch*78.233;
per_frame_129=paletteCooldown = if(paletteEvent,3,paletteCooldown);
per_frame_130=paletteIdle = if(paletteEvent,0,paletteIdle);
per_frame_131=paletteMorph = if(paletteBootstrap,1,if(paletteEvent,0,paletteMorph));
per_frame_132=paletteMorph = min(paletteMorph+frameDt/1.10,1);
per_frame_133=// Persistent custom state, not q outputs, supplies the previous palette.
per_frame_134=paletteFromPH = if(paletteEvent,paletteCurrentPH,paletteFromPH);
per_frame_135=paletteFromPS = if(paletteEvent,paletteCurrentPS,paletteFromPS);
per_frame_136=paletteFromPV = if(paletteEvent,paletteCurrentPV,paletteFromPV);
per_frame_137=// A random walk with a 58-degree minimum avoids repeated hue neighborhoods.
per_frame_138=paletteRandom = sin(paletteHashSeed + 0.17)*43758.5453;
per_frame_139=paletteHueStep = 0.16 + 0.34*(paletteRandom-floor(paletteRandom));
per_frame_140=paletteRandom = sin(paletteHashSeed + 1.31)*43758.5453;
per_frame_141=paletteHueSign = if(above(paletteRandom-floor(paletteRandom),0.5),1,-1); evolutionPaletteShift = if(paletteEvent,0.045*sin(evolutionAge*0.14),evolutionPaletteShift);
per_frame_142=paletteBaseHue = paletteFromPH + paletteHueSign*paletteHueStep + evolutionPaletteShift;
per_frame_143=paletteRandom = sin(paletteHashSeed + 2.11)*43758.5453;
per_frame_144=paletteDirection = if(above(paletteRandom-floor(paletteRandom),0.5),1,-1);
per_frame_145=paletteTargetPH = paletteBaseHue;
per_frame_146=paletteRandom = sin(paletteHashSeed + 3.41)*43758.5453;
per_frame_147=paletteTargetPS = 0.55 + 0.25*(paletteRandom-floor(paletteRandom));
per_frame_148=paletteRandom = sin(paletteHashSeed + 4.19)*43758.5453;
per_frame_149=paletteTargetPV = 0.82 + 0.16*(paletteRandom-floor(paletteRandom));
per_frame_150=paletteFromAH = if(paletteEvent,paletteCurrentAH,paletteFromAH);
per_frame_151=paletteFromAS = if(paletteEvent,paletteCurrentAS,paletteFromAS);
per_frame_152=paletteFromAV = if(paletteEvent,paletteCurrentAV,paletteFromAV);
per_frame_153=paletteRandom = sin(paletteHashSeed + 5.23)*43758.5453;
per_frame_154=paletteTargetAH = paletteBaseHue + paletteDirection*(0.20 + 0.16*(paletteRandom-floor(paletteRandom)));
per_frame_155=paletteTargetDelta = paletteTargetAH-paletteFromAH;
per_frame_156=paletteTargetDelta = paletteTargetDelta-floor(paletteTargetDelta+0.5);
per_frame_157=paletteTargetAH = if(below(abs(paletteTargetDelta),0.14),paletteFromAH+if(above(paletteTargetDelta,0),1,-1)*0.14,paletteTargetAH);
per_frame_158=paletteRandom = sin(paletteHashSeed + 6.11)*43758.5453;
per_frame_159=paletteTargetAS = 0.55 + 0.25*(paletteRandom-floor(paletteRandom));
per_frame_160=paletteRandom = sin(paletteHashSeed + 6.83)*43758.5453;
per_frame_161=paletteTargetAV = 0.82 + 0.16*(paletteRandom-floor(paletteRandom));
per_frame_162=paletteFromBH = if(paletteEvent,paletteCurrentBH,paletteFromBH);
per_frame_163=paletteFromBS = if(paletteEvent,paletteCurrentBS,paletteFromBS);
per_frame_164=paletteFromBV = if(paletteEvent,paletteCurrentBV,paletteFromBV);
per_frame_165=paletteRandom = sin(paletteHashSeed + 7.39)*43758.5453;
per_frame_166=paletteTargetBH = paletteBaseHue + paletteDirection*(0.44 + 0.16*(paletteRandom-floor(paletteRandom)));
per_frame_167=paletteTargetDelta = paletteTargetBH-paletteFromBH;
per_frame_168=paletteTargetDelta = paletteTargetDelta-floor(paletteTargetDelta+0.5);
per_frame_169=paletteTargetBH = if(below(abs(paletteTargetDelta),0.14),paletteFromBH+if(above(paletteTargetDelta,0),1,-1)*0.14,paletteTargetBH);
per_frame_170=paletteRandom = sin(paletteHashSeed + 8.17)*43758.5453;
per_frame_171=paletteTargetBS = 0.55 + 0.25*(paletteRandom-floor(paletteRandom));
per_frame_172=paletteRandom = sin(paletteHashSeed + 8.89)*43758.5453;
per_frame_173=paletteTargetBV = 0.82 + 0.16*(paletteRandom-floor(paletteRandom));
per_frame_174=paletteFromCH = if(paletteEvent,paletteCurrentCH,paletteFromCH);
per_frame_175=paletteFromCS = if(paletteEvent,paletteCurrentCS,paletteFromCS);
per_frame_176=paletteFromCV = if(paletteEvent,paletteCurrentCV,paletteFromCV);
per_frame_177=paletteRandom = sin(paletteHashSeed + 9.37)*43758.5453;
per_frame_178=paletteTargetCH = paletteBaseHue + paletteDirection*(0.68 + 0.16*(paletteRandom-floor(paletteRandom)));
per_frame_179=paletteTargetDelta = paletteTargetCH-paletteFromCH;
per_frame_180=paletteTargetDelta = paletteTargetDelta-floor(paletteTargetDelta+0.5);
per_frame_181=paletteTargetCH = if(below(abs(paletteTargetDelta),0.14),paletteFromCH+if(above(paletteTargetDelta,0),1,-1)*0.14,paletteTargetCH);
per_frame_182=paletteRandom = sin(paletteHashSeed + 10.13)*43758.5453;
per_frame_183=paletteTargetCS = 0.55 + 0.25*(paletteRandom-floor(paletteRandom));
per_frame_184=paletteRandom = sin(paletteHashSeed + 10.79)*43758.5453;
per_frame_185=paletteTargetCV = 0.82 + 0.16*(paletteRandom-floor(paletteRandom));
per_frame_186=paletteDeltaH = paletteTargetPH-paletteFromPH;
per_frame_187=paletteDeltaH = paletteDeltaH-floor(paletteDeltaH+0.5);
per_frame_188=paletteCurrentPH = paletteFromPH + paletteDeltaH*paletteMorph;
per_frame_189=paletteCurrentPS = paletteFromPS + (paletteTargetPS-paletteFromPS)*paletteMorph;
per_frame_190=paletteCurrentPV = paletteFromPV + (paletteTargetPV-paletteFromPV)*paletteMorph;
per_frame_191=q21 = paletteCurrentPV*(1-paletteCurrentPS+paletteCurrentPS*(0.5+0.5*cos(6.28318530718*paletteCurrentPH)));
per_frame_192=q22 = paletteCurrentPV*(1-paletteCurrentPS+paletteCurrentPS*(0.5+0.5*cos(6.28318530718*(paletteCurrentPH-0.33333333333))));
per_frame_193=q23 = paletteCurrentPV*(1-paletteCurrentPS+paletteCurrentPS*(0.5+0.5*cos(6.28318530718*(paletteCurrentPH-0.66666666667))));
per_frame_194=paletteDeltaH = paletteTargetAH-paletteFromAH;
per_frame_195=paletteDeltaH = paletteDeltaH-floor(paletteDeltaH+0.5);
per_frame_196=paletteCurrentAH = paletteFromAH + paletteDeltaH*paletteMorph;
per_frame_197=paletteCurrentAS = paletteFromAS + (paletteTargetAS-paletteFromAS)*paletteMorph;
per_frame_198=paletteCurrentAV = paletteFromAV + (paletteTargetAV-paletteFromAV)*paletteMorph;
per_frame_199=q9 = paletteCurrentAV*(1-paletteCurrentAS+paletteCurrentAS*(0.5+0.5*cos(6.28318530718*paletteCurrentAH)));
per_frame_200=q10 = paletteCurrentAV*(1-paletteCurrentAS+paletteCurrentAS*(0.5+0.5*cos(6.28318530718*(paletteCurrentAH-0.33333333333))));
per_frame_201=q11 = paletteCurrentAV*(1-paletteCurrentAS+paletteCurrentAS*(0.5+0.5*cos(6.28318530718*(paletteCurrentAH-0.66666666667))));
per_frame_202=paletteDeltaH = paletteTargetBH-paletteFromBH;
per_frame_203=paletteDeltaH = paletteDeltaH-floor(paletteDeltaH+0.5);
per_frame_204=paletteCurrentBH = paletteFromBH + paletteDeltaH*paletteMorph;
per_frame_205=paletteCurrentBS = paletteFromBS + (paletteTargetBS-paletteFromBS)*paletteMorph;
per_frame_206=paletteCurrentBV = paletteFromBV + (paletteTargetBV-paletteFromBV)*paletteMorph;
per_frame_207=q12 = paletteCurrentBV*(1-paletteCurrentBS+paletteCurrentBS*(0.5+0.5*cos(6.28318530718*paletteCurrentBH)));
per_frame_208=q13 = paletteCurrentBV*(1-paletteCurrentBS+paletteCurrentBS*(0.5+0.5*cos(6.28318530718*(paletteCurrentBH-0.33333333333))));
per_frame_209=q14 = paletteCurrentBV*(1-paletteCurrentBS+paletteCurrentBS*(0.5+0.5*cos(6.28318530718*(paletteCurrentBH-0.66666666667))));
per_frame_210=paletteDeltaH = paletteTargetCH-paletteFromCH;
per_frame_211=paletteDeltaH = paletteDeltaH-floor(paletteDeltaH+0.5);
per_frame_212=paletteCurrentCH = paletteFromCH + paletteDeltaH*paletteMorph;
per_frame_213=paletteCurrentCS = paletteFromCS + (paletteTargetCS-paletteFromCS)*paletteMorph;
per_frame_214=paletteCurrentCV = paletteFromCV + (paletteTargetCV-paletteFromCV)*paletteMorph;
per_frame_215=q15 = paletteCurrentCV*(1-paletteCurrentCS+paletteCurrentCS*(0.5+0.5*cos(6.28318530718*paletteCurrentCH)));
per_frame_216=q16 = paletteCurrentCV*(1-paletteCurrentCS+paletteCurrentCS*(0.5+0.5*cos(6.28318530718*(paletteCurrentCH-0.33333333333))));
per_frame_217=q17 = paletteCurrentCV*(1-paletteCurrentCS+paletteCurrentCS*(0.5+0.5*cos(6.28318530718*(paletteCurrentCH-0.66666666667))));
per_frame_218=// A short release makes white visible without extending the hard-impact orbit.
per_frame_219=whiteTarget = max(hardTransient,0.45*bodyTarget);
per_frame_220=whiteEnvelope = max(whiteTarget,whiteEnvelope*pow(0.0005,frameDt));
per_frame_221=whiteEnvelope = if(below(whiteEnvelope,0.002),0,whiteEnvelope);
per_frame_222=q18 = q2*whiteEnvelope*min(q6*1.3,1);
per_frame_223=// Body makes a small burst; hard impacts use the full short envelope.
per_frame_224=sparkTarget = max(hardTransient,0.35*bodyTarget);
per_frame_225=spark = max(sparkTarget,spark*pow(0.0001,frameDt));
per_frame_226=spark = if(below(spark,0.002),0,spark);
per_frame_227=q19 = min(ambientValid*(0.030 + 0.035*q8 + 0.025*body + 0.080*q24),0.10);
per_frame_228=q20 = q2*spark;
per_frame_229=cometCooldown = max(cometCooldown-frameDt,0);
per_frame_230=cometSectionEdge = above(sectionActive,0.5)*below(cometLastSection,0.5);
per_frame_231=cometLastSection = sectionActive;
per_frame_232=cometTrigger = cometSectionEdge*below(cometCooldown,0.001)*below(cometActive,0.5);
per_frame_233=cometAge = if(cometTrigger,0,if(below(cometAge,0.90),cometAge+frameDt,cometAge));
per_frame_234=cometEnvelope = min(cometAge/0.06,1)*min(max((0.90-cometAge)/0.12,0),1);
per_frame_235=cometActive = if(cometTrigger,1,if(above(sectionQuietTime,0.10),0,if(below(sectionActive,0.5),0,if(above(cometAge,0.90),0,cometActive))));
per_frame_236=cometCooldown = if(cometTrigger,12,cometCooldown);
per_frame_237=evolutionSignal = sectionActive*max(above(sustainedRatio,1.05),absoluteAvailable*above(absoluteSlow,0.45));
per_frame_238=evolutionAge = if(evolutionSignal,min(evolutionAge+frameDt,90),if(below(sectionActive,0.5),max(evolutionAge-frameDt*1.5,0),max(evolutionAge-frameDt*0.35,0)));
per_frame_239=evolutionRadius = 1 + 0.10*sin(evolutionAge*0.24);
per_frame_240=evolutionEllipticity = 1 + 0.08*sin(evolutionAge*0.19);
per_frame_241=q25 = evolutionRadius;
per_frame_242=q26 = evolutionEllipticity;
per_frame_243=q27 = cometAge;
per_frame_244=q28 = cometEnvelope;
per_frame_245=q29 = cometActive;
per_frame_246=q30 = cometTrigger;
per_pixel_1=zoom = 1 + 0.05*q7*rad;
per_pixel_2=rot = 0;
warp_1=`shader_body
warp_2=`{
warp_3=`    float2 texel = texsize.zw;
warp_4=`    // Preserve the original one-sided taps; symmetric averaging blurs the history.
warp_5=`    float3 shifted_x = GetPixel(uv + float2(texel.x,0.0));
warp_6=`    float3 shifted_y = GetPixel(uv + float2(0.0,texel.y));
warp_7=`    ret = shifted_x + shifted_y - tex2D(sampler_main,(uv-0.5)*0.9 + 0.5);
warp_8=`    // Original per-frame feedback: dark dissolve at rest, longer trails on impacts.
warp_9=`    ret -= (0.55 - 0.27*q5);
warp_10=`}
comp_1=`float3 SmoothBloom(float2 p)
comp_2=`{
comp_3=`    // Four-tap reconstruction at half a 1/16-resolution bloom texel.
comp_4=`    float2 d = texsize.zw*8.0;
comp_5=`    return (GetBlur3(p + float2(-d.x,-d.y))
comp_6=`          + GetBlur3(p + float2( d.x,-d.y))
comp_7=`          + GetBlur3(p + float2(-d.x, d.y))
comp_8=`          + GetBlur3(p + float2( d.x, d.y)))*0.25;
comp_9=`}
comp_10=`shader_body
comp_11=`{
comp_12=`    float2 uv_echo = 1.0 - uv;
comp_13=`    float2 ca_offset = (uv - 0.5)*(0.03*q4);
comp_14=`    // Low ambient floor; the macro level supplies groove and impact headroom.
comp_15=`    float echo_gain = 0.10 + 0.75*q6;
comp_16=`    float bloom_gain = 0.15 + 2.15*q6;
comp_17=`    // Keep the fresh core unshifted; chromatic separation belongs to the echo.
comp_18=`    float3 core = tex2D(sampler_main,uv).xyz;
comp_19=`    float3 echo = float3(tex2D(sampler_main,uv_echo - ca_offset).r,
comp_20=`                         tex2D(sampler_main,uv_echo).g,
comp_21=`                         tex2D(sampler_main,uv_echo + ca_offset).b);
comp_22=`    ret = core + echo*echo_gain;
comp_23=`    ret += (SmoothBloom(uv) + SmoothBloom(uv_echo))*bloom_gain;
comp_24=`    // Normalize only over-range highlights, preserving hue and in-range levels.
comp_25=`    float peak = max(ret.r,max(ret.g,ret.b));
comp_26=`    ret /= max(peak,1.0);
comp_27=`    // Whiten only bright high-frequency core detail, never broad fills or bloom.
comp_28=`    float core_peak = max(core.r,max(core.g,core.b));
comp_29=`    float3 local_blur = GetBlur1(uv);
comp_30=`    float blur_peak = max(local_blur.r,max(local_blur.g,local_blur.b));
comp_31=`    float core_detail = max(core_peak-blur_peak,0);
comp_32=`    float core_mask = smoothstep(0.55,0.90,core_peak)*smoothstep(0.10,0.35,core_detail);
comp_33=`    core_mask = core_mask*core_mask*q18;
comp_34=`    ret = lerp(ret,float3(1.0,1.0,1.0),core_mask);
comp_35=`    // Static sub-LSB dither reduces 8-bit banding without temporal shimmer.
comp_36=`    float dither = frac(sin(dot(uv*texsize.xy,float2(12.9898,78.233)))*43758.5453);
comp_37=`    ret += (dither - 0.5)/255.0;
comp_38=`}

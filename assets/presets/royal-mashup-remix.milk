shape_2_per_frame1=// Twelve short-lived sparks expand only with body/hard-action energy.
shape_2_per_frame2=angle = instance*2.39996322973 + time*0.18;
shape_2_per_frame3=variation = 0.5 + 0.5*sin(instance*5.37 + 0.8);
shape_2_per_frame4=travel = (1-min(q20,1))*(0.12 + 0.08*variation);
shape_2_per_frame5=distance = 0.18 + travel;
shape_2_per_frame6=x = 0.5 + distance*cos(angle);
shape_2_per_frame7=y = 0.5 + distance*0.72*sin(angle);
shape_2_per_frame8=rad = 0.0045 + 0.0045*min(q20,1);
shape_2_per_frame9=ang = -time*0.30 + instance;
shape_2_per_frame10=pick = instance%2;
shape_2_per_frame11=r = q15*(1-pick) + q9*pick;
shape_2_per_frame12=g = q16*(1-pick) + q10*pick;
shape_2_per_frame13=b = q17*(1-pick) + q11*pick;
shape_2_per_frame14=a = min(q20*0.65,0.65)*(0.70 + 0.30*variation);
shape_2_per_frame15=a2 = a*0.35;
shape_2_per_frame16=r2 = r;
shape_2_per_frame17=g2 = g;
shape_2_per_frame18=b2 = b;

wave_2_per_point1=speed = bass_att*0.8;
wave_2_per_point2=phase = sample*1000000 + value2*bass*0.1;
wave_2_per_point3=stateX = stateX + sin(phase)*speed*atan(phase*1.51);
wave_2_per_point4=stateY = stateY + sin(phase)*speed*atan(phase*10);
wave_2_per_point5=x = 0.5 + 0.5*sin(stateX*0.1)*cos(time*0.2 + stateX);
wave_2_per_point6=y = 0.5 + 0.5*sin(stateY*0.14)*cos(time*0.1 + stateX);
wave_2_per_point7=x = x*0.8 + 0.1;
wave_2_per_point8=y = y*0.8 + 0.1;
wave_2_per_point9=x = x*0.25 + 0.375;
wave_2_per_point10=y = y*0.25 + 0.375;
wave_2_per_point11=calm = q2*min((1-min(q8*5,1))*1.5,1);
wave_2_per_point12=arcPhase = (sample-0.5)*4.2 + time*0.12;
wave_2_per_point13=x = (1-calm)*x + calm*(0.5+0.28*cos(arcPhase));
wave_2_per_point14=y = (1-calm)*y + calm*(0.5+0.28*0.72*sin(arcPhase));
wave_2_per_point15=x = 0.5 + (x-0.5)*q25;
wave_2_per_point16=y = 0.5 + (y-0.5)*q26;
wave_2_per_point17=// Accent B gives the calm arc its own color within the shared palette.
wave_2_per_point18=shade = 0.90 + 0.10*sin(sample*6.28318530718 + 4.2);
wave_2_per_point19=r = q12*shade;
wave_2_per_point20=g = q13*shade;
wave_2_per_point21=b = q14*shade;
wave_2_per_point22=stateX = if(above(abs(stateX),1000),0,stateX);
wave_2_per_point23=stateY = if(above(abs(stateY),1000),0,stateY);
wave_2_per_point24=a = max(min(q8,0.80),q6*calm*1.2)*sin(sample*3.14159265359);

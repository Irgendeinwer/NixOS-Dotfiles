/* Layout only: the color variables (bg0, fg1, surface, ...) are generated
   from custom.theme.palette in rofi.nix and prepended to this file. */

window {
    location: center;
    anchor:   center;
    border-radius: 20px;
    height: 560px;
    width: 600px;

    background-color: @surface;
    spacing: 0;
    children:  [mainbox];
    orientation: horizontal;
}

mainbox {
    spacing: 0;
    children: [ inputbar, message, listview ];
}

message {
    padding: 10px;
    border:  0px 2px 2px 2px;
    border-color: @bg0;
    background-color: @surface;
}

inputbar {
    color: @fg1;
    padding: 14px;
    background-color: @surface;
    border-color: @fg1;

    border: 4px;
    border-radius: 20px 20px 0px 0px;
}

entry, prompt, case-indicator {
    text-font: inherit;
    text-color: inherit;
}

prompt {
    margin: 0px 1em 0em 0em ;
}

listview {
    padding: 8px;
    border-radius: 0px 0px 20px 20px;
    border: 0px 4px 4px 4px;
    border-color: @fg1;
    background-color: @surface;
    dynamic: false;
}

element {
    padding: 5px;
    vertical-align: 0.5;
    border-radius: 5px;
    color: @foreground;
    text-color: @fg1;
    background-color: @surface;
}

element.normal.active {
    background-color: @bg-visual-yellow;
}

element.normal.urgent {
    background-color: @bg-visual-red;
}

element.selected.normal {
    background-color: @grey2;
    text-color: @bg0;
}

element.selected.active {
    background-color: @yellow;
    text-color: @bg0;
}

element.selected.urgent {
    background-color: @red;
    text-color: @bg0;
}

element.alternate.normal {
    background-color: @surface;
}

element-text, element-icon {
    size: 3ch;
    margin: 0 10 0 0;
    vertical-align: 0.5;
    /* Follow the row state, so the selected entry gets dark text */
    text-color: inherit;
}

button {
    padding: 6px;
    color: @foreground;
    horizontal-align: 0.5;

    border: 2px 0px 2px 2px;
    border-radius: 5px;
    border-color: @foreground;
}

button.selected.normal {
    border: 2px 0px 2px 2px;
    border-color: @foreground;
}

+                // Butterchurn normalizes its band levels over time. Supply the
+                // previous frame's raw stereo RMS to this preset through b3n;
+                // the preset immediately restores that blur control to zero.
+                const originalRender = butterchurnInstance.render.bind(butterchurnInstance);
+                butterchurnInstance.render = () => {
+                    const internal = butterchurnInstance as any;
+                    const renderer = internal.renderer;
+                    const left = renderer?.audio?.timeByteArraySignedL;
+                    const right = renderer?.audio?.timeByteArraySignedR;
+                    let rms: number | undefined;
+
+                    if (left && right && left.length === right.length) {
+                        let power = 0;
+                        for (let i = 0; i < left.length; i++) {
+                            power += left[i] * left[i] + right[i] * right[i];
+                        }
+                        rms = Math.sqrt(power / (left.length * 2)) / 128;
+                    }
+
+                    const runners = [
+                        renderer?.presetEquationRunner,
+                        renderer?.prevPresetEquationRunner,
+                    ];
+                    for (const runner of runners) {
+                        if (!runner?.mdVS) continue;
+                        const isRoyal = runner.preset?.frame_eqs_eel?.includes(
+                            'absoluteInput = b3n',
+                        );
+                        if (isRoyal && rms !== undefined) {
+                            runner.mdVS.b3n = rms + 0.000001;
+                            runner.royalAbsoluteInput = true;
+                        } else if (runner.royalAbsoluteInput) {
+                            runner.mdVS.b3n = 0;
+                            runner.royalAbsoluteInput = false;
+                        }
+                    }
+
+                    originalRender();
+                };
